{
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    // No permission flags: the suite must run with no ambient access at all, so
    // an unstubbed fetch fails loudly instead of hitting the network.
    "test": "deno test"
  },
  "imports": {
    "@actions/core": "npm:@actions/core@^3.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.20"
  }
}
